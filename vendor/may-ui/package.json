{
  "name": "@adit_firdaus/may-ui",
  "version": "0.2.0",
  "description": "May UI — an Apple-native React design system with iOS design language and real spring motion.",
  "type": "module",
  "license": "MIT",
  "author": "Adit Firdaus <aditfirdaus.dml@gmail.com>",
  "homepage": "https://github.com/adit-firdaus/may-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adit-firdaus/may-ui.git"
  },
  "bugs": {
    "url": "https://github.com/adit-firdaus/may-ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "ios",
    "apple",
    "tailwind-free"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/mayui.cjs",
  "module": "./dist/mayui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mayui.js",
      "require": "./dist/mayui.cjs"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js",
      "require": "./dist/desktop.cjs"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "require": "./dist/mobile.cjs"
    },
    "./package.json": "./package.json",
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js",
      "require": "./dist/examples.cjs"
    }
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "react-icons": "^5.7.0"
  },
  "vendoredFrom": "/Users/af/Documents/Projects/mayui",
